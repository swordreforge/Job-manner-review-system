# 数据库配置
MYSQL_ROOT_PASSWORD=change_me_to_a_secure_password
MYSQL_DATABASE=career_db
MYSQL_USER=career
MYSQL_PASSWORD=change_me_to_a_secure_password
MYSQL_PORT=3306
MYSQL_DATASOURCE=root:change_me_to_a_secure_password@tcp(localhost:3306)/career_db?charset=utf8mb4&parseTime=true&loc=Local

# Redis 配置
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
REDIS_PORT=6379

# JWT 配置
JWT_SECRET=change_me_to_a_random_256bit_secret

# AI 配置
AI_PROVIDER=deepseek
AI_API_KEY=change_me_to_your_api_key
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com/v1

# 讯飞星火语音识别配置
XUNFEI_APP_ID=change_me
XUNFEI_API_KEY=change_me
XUNFEI_API_SECRET=change_me
XUNFEI_PORT=8000

# 后端配置
BACKEND_PORT=8088
PROMETHEUS_PORT=9091

# 前端配置
FRONTEND_PORT=80

# Nginx 配置（可选）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443