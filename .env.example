# SQLite 数据库配置（用于登录功能）
# 默认值: sqlite:auth.db
SQLITE_DATABASE_URL=sqlite:auth.db

# MySQL 数据库配置（用于管理功能，必需）
# 格式: mysql://用户名:密码@主机:端口/数据库名
MYSQL_DATABASE_URL=mysql://root:your_password@localhost/career_db

# 服务器配置（可选，默认值：127.0.0.1:8081）
SERVER_HOST=127.0.0.1
SERVER_PORT=8081

# JWT密钥（可选，生产环境请修改）
JWT_SECRET=your-secret-key-change-in-production